<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" styleClass="system-name" stylesheets="@../css/principal.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cibi.controller.MainController">
   <left>
      <VBox fx:id="sidebar" maxWidth="220.0" minHeight="72.0" minWidth="64.0" prefWidth="220.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="sidebarHeader" maxHeight="66.0" minHeight="66.0" prefHeight="66.0" prefWidth="100.0" styleClass="sidebar-header">
               <children>
                  <HBox fx:id="brandBox" alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="200.0" spacing="10.0" styleClass="brand">
                     <children>
                        <StackPane fx:id="logoContainer" maxHeight="28.0" maxWidth="28.0" minHeight="28.0" minWidth="28.0" prefHeight="28.0" prefWidth="28.0" styleClass="brand-icon">
                           <children>
                              <Label fx:id="lblLogoIcon" styleClass="logo-icon" text="*" />
                           </children>
                        </StackPane>
                        <Label fx:id="lblSystemName" styleClass="brand-name" text="CIBI" />
                     </children>
                  </HBox>
                  <Region prefHeight="200.0" prefWidth="200.0" styleClass="divider" />
               </children>
            </VBox>
            <VBox fx:id="navigationWrapper" maxHeight="1.7976931348623157E308" prefHeight="200.0" prefWidth="100.0" styleClass="navigation" VBox.vgrow="ALWAYS">
               <children>
                  <VBox fx:id="menuContainer" prefHeight="200.0" prefWidth="100.0" spacing="4.0" styleClass="menu-container" VBox.vgrow="NEVER">
                     <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#abrirDashboard" prefHeight="34.0" text="Dashboard">
                           <styleClass>
                              <String fx:value="sidebar-menu-item" />
                              <String fx:value="button-custom" />
                           </styleClass></Button>
                        <Button fx:id="btnLivros" mnemonicParsing="false" onAction="#abrirLivros" prefHeight="34.0" text="Livros">
                           <styleClass>
                              <String fx:value="sidebar-menu-item" />
                              <String fx:value="button-custom" />
                           </styleClass></Button>
                        <Button fx:id="btnEmprestimos" mnemonicParsing="false" onAction="#abrirEmprestimos" prefHeight="34.0" text="Emprestimos">
                           <styleClass>
                              <String fx:value="sidebar-menu-item" />
                              <String fx:value="button-custom" />
                           </styleClass></Button>
                        <Button fx:id="btnUsuarios" mnemonicParsing="false" onAction="#abrirUsuarios" prefHeight="34.0" text="Usuários">
                           <styleClass>
                              <String fx:value="sidebar-menu-item" />
                              <String fx:value="button-custom" />
                           </styleClass></Button>
                     </children>
                  </VBox>
                  <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                  <Button fx:id="btnSobre" mnemonicParsing="false" onAction="#abrirSobre" prefHeight="34.0" text="Configurações">
                     <styleClass>
                        <String fx:value="sidebar-menu-item" />
                        <String fx:value="button-custom" />
                     </styleClass>
                  </Button>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" top="22.0" />
               </padding>
            </VBox>
            <VBox fx:id="sidebarBottom" maxHeight="54.0" minHeight="54.0" prefHeight="54.0" prefWidth="100.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="44.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <StackPane maxHeight="34.0" maxWidth="34.0" minHeight="34.0" minWidth="34.0" prefHeight="34.0" prefWidth="34.0">
                           <children>
                              <Label text="AT" />
                           </children>
                        </StackPane>
                        <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Nome Usuario" />
                              <Label text="email@gmail.com" />
                           </children>
                        </VBox>
                        <Label text="↗" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" prefHeight="150.0" prefWidth="200.0" styleClass="content-area" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
