<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="config-root" stylesheets="@Configuracoes.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cibi.controller.pages.ConfiguracoesController">
   <children>
      <VBox prefHeight="200.0" prefWidth="100.0" styleClass="config-header">
         <padding>
            <Insets left="40.0" right="40.0" top="32.0" />
         </padding>
         <children>
            <Label styleClass="page-title" text="Configurações" />
            <HBox fx:id="barraAbas" prefHeight="100.0" prefWidth="200.0" spacing="8.0" styleClass="tab-bar">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
               <children>
                  <ToggleButton fx:id="abaAparencia" mnemonicParsing="false" selected="true" styleClass="tab-button" text="Aparência">
                     <toggleGroup>
                        <ToggleGroup fx:id="grupoAbas" />
                     </toggleGroup>
                  </ToggleButton>
                  <ToggleButton fx:id="abaEmprestimos" mnemonicParsing="false" styleClass="tab-button" text="Empréstimos" toggleGroup="$grupoAbas" />
                  <ToggleButton fx:id="abaNotificacoes" mnemonicParsing="false" styleClass="tab-button" text="Notificações" toggleGroup="$grupoAbas" />
                  <ToggleButton fx:id="abaSistema" mnemonicParsing="false" styleClass="tab-button" text="Sistema" toggleGroup="$grupoAbas" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
