<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" spacing="18" styleClass="books-root" stylesheets="@../../css/pages/Livros.css" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cibi.controller.pages.LivrosController">
   <padding><Insets top="24" right="28" bottom="24" left="28" /></padding>
   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="books-header">
      <VBox spacing="3">
         <Label styleClass="books-title" text="Livros" />
         <Label styleClass="books-subtitle" text="Gerencie o acervo da biblioteca" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <Button onAction="#novoLivro" styleClass="primary-button" text="＋  Novo Livro" />
      <Button onAction="#exportar" styleClass="secondary-button" text="⇩  Exportar" />
   </HBox>

   <HBox spacing="14" styleClass="summary-row">
      <VBox styleClass="summary-card" HBox.hgrow="ALWAYS"><Label styleClass="summary-caption" text="Total de Livros" /><Label fx:id="lblTotal" styleClass="summary-value" text="—" /></VBox>
      <VBox styleClass="summary-card" HBox.hgrow="ALWAYS"><Label styleClass="summary-caption" text="Disponíveis" /><Label styleClass="summary-value,summary-available" text="—" /></VBox>
      <VBox styleClass="summary-card" HBox.hgrow="ALWAYS"><Label styleClass="summary-caption" text="Emprestados" /><Label styleClass="summary-value,summary-loaned" text="—" /></VBox>
      <VBox styleClass="summary-card" HBox.hgrow="ALWAYS"><Label styleClass="summary-caption" text="Categorias" /><Label styleClass="summary-value,summary-categories" text="—" /></VBox>
   </HBox>

   <VBox maxHeight="1.7976931348623157E308" minHeight="0" spacing="0" styleClass="books-panel" VBox.vgrow="ALWAYS">
      <HBox alignment="CENTER_LEFT" spacing="10" styleClass="books-toolbar">
         <TextField fx:id="txtBusca" promptText="Buscar por título ou autor" styleClass="search-field" HBox.hgrow="ALWAYS" />
         <ComboBox fx:id="filtroCategoria" disable="true" prefWidth="120" promptText="Categoria" styleClass="filter-combo" />
         <ComboBox fx:id="filtroStatus" disable="true" prefWidth="105" promptText="Status" styleClass="filter-combo" />
         <ComboBox fx:id="filtroAno" disable="true" prefWidth="90" promptText="Ano" styleClass="filter-combo" />
         <ComboBox fx:id="comboOrdenar" prefWidth="180" styleClass="filter-combo" />
      </HBox>
      <TableView fx:id="tabelaLivros" maxHeight="1.7976931348623157E308" minHeight="0" styleClass="books-table" VBox.vgrow="ALWAYS">
         <placeholder><Label text="Nenhum livro encontrado" /></placeholder>
         <columns>
            <TableColumn fx:id="colId" minWidth="38" maxWidth="75" prefWidth="52" text="Id" />
            <TableColumn fx:id="colTitulo" minWidth="105" prefWidth="205" text="Título" />
            <TableColumn fx:id="colAutor" minWidth="95" prefWidth="175" text="Autor" />
            <TableColumn fx:id="colCategoria" minWidth="65" prefWidth="105" text="Categoria" />
            <TableColumn fx:id="colIsbn" minWidth="65" prefWidth="115" text="ISBN" />
            <TableColumn fx:id="colAno" minWidth="42" maxWidth="75" prefWidth="55" text="Ano" />
            <TableColumn fx:id="colQuantidade" minWidth="50" maxWidth="85" prefWidth="63" text="Quant." />
            <TableColumn fx:id="colDisponiveis" minWidth="60" maxWidth="105" prefWidth="83" text="Disponíveis" />
            <TableColumn fx:id="colStatus" minWidth="55" prefWidth="85" text="Status" />
            <TableColumn fx:id="colAcoes" minWidth="88" maxWidth="88" prefWidth="88" text="Ações" />
         </columns>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="pagination-bar">
         <Button fx:id="btnAnterior" onAction="#paginaAnterior" styleClass="page-button" text="Anterior" />
         <HBox fx:id="paginasNumeradas" alignment="CENTER_RIGHT" spacing="6" />
         <Button fx:id="btnProximo" onAction="#proximaPagina" styleClass="page-button" text="Próximo  ❯" />
      </HBox>
   </VBox>
   <HBox alignment="CENTER_RIGHT"><Label fx:id="lblResultados" styleClass="results-label" text="Carregando livros..." /></HBox>
   <Label fx:id="lblMensagem" styleClass="feedback-label" text="" wrapText="true" />
</VBox>
