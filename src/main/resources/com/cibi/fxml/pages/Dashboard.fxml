<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="dashboard-root" stylesheets="@../../css/pages/Dashboard.css" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cibi.controller.pages.DashboardController">
         <padding><Insets top="18" right="22" bottom="18" left="22" /></padding>
         <HBox alignment="CENTER_LEFT">
            <Label styleClass="dashboard-title" text="Tela Principal" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblResumoStatus" styleClass="dashboard-status" text="Carregando totais..." />
         </HBox>
         <GridPane hgap="10">
            <columnConstraints>
               <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
               <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
               <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
               <ColumnConstraints percentWidth="25" hgrow="ALWAYS" />
            </columnConstraints>
            <VBox styleClass="metric-card,metric-books" GridPane.columnIndex="0">
               <HBox alignment="CENTER_LEFT" spacing="12" styleClass="metric-top">
                  <Region styleClass="bi-icon,metric-icon,bi-bookshelf" />
                  <VBox><Label styleClass="metric-heading" text="Livros" /><Label styleClass="metric-subheading" text="Cadastrados" /></VBox>
               </HBox>
               <Label fx:id="lblLivrosCadastrados" styleClass="metric-value" text="—" />
            </VBox>
            <VBox styleClass="metric-card,metric-available" GridPane.columnIndex="1">
               <HBox alignment="CENTER_LEFT" spacing="12" styleClass="metric-top">
                  <Region styleClass="bi-icon,metric-icon,bi-journal-check" />
                  <VBox><Label styleClass="metric-heading" text="Livros" /><Label styleClass="metric-subheading" text="Disponíveis" /></VBox>
               </HBox>
               <Label styleClass="metric-value" text="—" />
            </VBox>
            <VBox styleClass="metric-card,metric-loans" GridPane.columnIndex="2">
               <HBox alignment="CENTER_LEFT" spacing="12" styleClass="metric-top">
                  <Region styleClass="bi-icon,metric-icon,bi-arrow-left-right" />
                  <VBox><Label styleClass="metric-heading" text="Empréstimos" /><Label styleClass="metric-subheading" text="em Curso" /></VBox>
               </HBox>
               <Label styleClass="metric-value" text="—" />
            </VBox>
            <VBox styleClass="metric-card,metric-users" GridPane.columnIndex="3">
               <HBox alignment="CENTER_LEFT" spacing="12" styleClass="metric-top">
                  <Region styleClass="bi-icon,metric-icon,bi-people" />
                  <VBox><Label styleClass="metric-heading" text="Usuários" /><Label styleClass="metric-subheading" text="Cadastrados" /></VBox>
               </HBox>
               <Label fx:id="lblUsuariosCadastrados" styleClass="metric-value" text="—" />
            </VBox>
         </GridPane>
         <HBox spacing="14" alignment="TOP_LEFT">
            <VBox spacing="10" minWidth="0" prefWidth="620" HBox.hgrow="ALWAYS">
               <VBox spacing="8" styleClass="dashboard-panel">
                  <Label styleClass="panel-title" text="Empréstimos Recentes" />
                  <Region styleClass="panel-divider" />
                  <GridPane styleClass="loan-header">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="25" /><ColumnConstraints percentWidth="40" /><ColumnConstraints percentWidth="22" /><ColumnConstraints percentWidth="13" />
                     </columnConstraints>
                     <Label text="Usuário" /><Label text="Livro" GridPane.columnIndex="1" /><Label text="Data do empréstimo" GridPane.columnIndex="2" GridPane.halignment="CENTER" /><Label text="Status" GridPane.columnIndex="3" GridPane.halignment="CENTER" />
                  </GridPane>
                  <VBox alignment="CENTER" minHeight="150" styleClass="loan-empty">
                     <Region styleClass="bi-icon,empty-icon,bi-book" />
                     <Label styleClass="empty-title" text="Empréstimos ainda não disponíveis" />
                     <Label styleClass="empty-caption" text="O módulo de empréstimos ainda não fornece registros ao painel." wrapText="true" />
                  </VBox>
               </VBox>
               <VBox spacing="8" styleClass="dashboard-panel">
                  <Label styleClass="panel-title" text="Acesso Rápido" />
                  <Region styleClass="panel-divider" />
                  <HBox spacing="12">
                     <Button maxWidth="Infinity" onAction="#abrirLivros" styleClass="quick-button,quick-book" text="Livros" HBox.hgrow="ALWAYS">
                        <graphic><Region styleClass="bi-icon,quick-icon,bi-book" /></graphic>
                     </Button>
                     <Button maxWidth="Infinity" onAction="#abrirUsuarios" styleClass="quick-button,quick-user" text="Novo Usuário" HBox.hgrow="ALWAYS">
                        <graphic><Region styleClass="bi-icon,quick-icon,bi-person-plus" /></graphic>
                     </Button>
                     <Button maxWidth="Infinity" onAction="#abrirEmprestimos" styleClass="quick-button,quick-loan" text="Empréstimos" HBox.hgrow="ALWAYS">
                        <graphic><Region styleClass="bi-icon,quick-icon,bi-arrow-left-right" /></graphic>
                     </Button>
                  </HBox>
               </VBox>
            </VBox>
            <VBox spacing="10" minWidth="0" prefWidth="395" HBox.hgrow="ALWAYS">
               <VBox spacing="8" styleClass="dashboard-panel">
                  <Label styleClass="panel-title" text="Pendências e Alertas" />
                  <Region styleClass="panel-divider" />
                  <HBox alignment="CENTER_LEFT" spacing="12" onMouseClicked="#abrirEmprestimos" styleClass="alert-card,alert-danger">
                     <StackPane styleClass="alert-icon"><Region styleClass="bi-icon,alert-symbol,bi-exclamation-circle" /></StackPane>
                     <VBox spacing="2" HBox.hgrow="ALWAYS"><Label styleClass="alert-title" text="Empréstimos atrasados" /><Label styleClass="alert-caption" text="Dados ainda não disponíveis" /></VBox>
                     <Region styleClass="bi-icon,alert-chevron,bi-chevron-right" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="12" onMouseClicked="#abrirEmprestimos" styleClass="alert-card,alert-info">
                     <StackPane styleClass="alert-icon"><Region styleClass="bi-icon,alert-symbol,bi-calendar-event" /></StackPane>
                     <VBox spacing="2" HBox.hgrow="ALWAYS"><Label styleClass="alert-title" text="Devoluções previstas para hoje" /><Label styleClass="alert-caption" text="Dados ainda não disponíveis" /></VBox>
                     <Region styleClass="bi-icon,alert-chevron,bi-chevron-right" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="12" onMouseClicked="#abrirEmprestimos" styleClass="alert-card,alert-success">
                     <StackPane styleClass="alert-icon"><Region styleClass="bi-icon,alert-symbol,bi-check-circle" /></StackPane>
                     <VBox spacing="2" HBox.hgrow="ALWAYS"><Label styleClass="alert-title" text="Devoluções realizadas hoje" /><Label styleClass="alert-caption" text="Dados ainda não disponíveis" /></VBox>
                     <Region styleClass="bi-icon,alert-chevron,bi-chevron-right" />
                  </HBox>
               </VBox>
               <VBox spacing="8" styleClass="dashboard-panel">
                  <Label styleClass="panel-title" text="Empréstimos Mensais" />
                  <VBox alignment="CENTER" minHeight="112" styleClass="chart-empty">
                     <Region styleClass="bi-icon,empty-icon,bi-bar-chart" />
                     <Label styleClass="empty-title" text="Histórico ainda não disponível" />
                     <Label styleClass="empty-caption" text="Os dados aparecerão quando houver registros de empréstimos." wrapText="true" />
                  </VBox>
               </VBox>
            </VBox>
         </HBox>
      </VBox>
